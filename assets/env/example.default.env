# Copy to default.env — claim-code / Telegram deep-link login (no in-app TDLib).
# API target: oxplayer-be apps/api (default port 3004).

OXPLAYER=true
OXPLAYER_API_BASE_URL=http://192.168.1.10:3004

# Main bot for /login, QR deep links, and help (without @)
BOT_USERNAME=YourMainBot

# Sentry (production — synced from Infisical /core/client-ci)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
