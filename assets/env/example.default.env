# Copy to default.env — claim-code / Telegram deep-link login (no in-app TDLib).
# API target: oxplayer-be apps/api (default port 3004).

OXPLAYER=true
OXPLAYER_API_BASE_URL=http://192.168.1.10:3004

# Iran cohort (Arvan CDN on oxplayer.ir) — optional overrides.
# OXPLAYER_API_BASE_ARVAN=https://api.oxplayer.ir
# OXPLAYER_STREAM_BASE_ARVAN=https://stream.oxplayer.ir
# OXPLAYER_ARVAN_EDGE_ADDR=          # pin Arvan edge IP; Host header from API base URL
# OXPLAYER_FORCE_EDGE=global          # global | arvan — skip probe / 451 flip

# Main bot for /login, QR deep links, and help (without @)
BOT_USERNAME=YourMainBot

# Sentry (optional — omit to disable crash reporting)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
