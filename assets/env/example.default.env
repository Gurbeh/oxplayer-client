# Copy to default.env — TDLib Telegram Mini App login (POST /auth/telegram).
# API target: oxplayer-be apps/api (default port 3004).

OXPLAYER=true
OXPLAYER_API_BASE_URL=http://192.168.1.10:3004

# Main bot for help / delete-account deep links (without @). Mini App auth bot is separate.
BOT_USERNAME=YourMainBot

# Sentry (production — synced from Infisical /core/client-ci)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
